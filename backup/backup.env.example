# Copy to backup.env next to docker-compose.yml on the Pi, fill it in and run
# `chmod 600 backup.env`. It holds secrets, so never commit it. Keep the token
# in a password manager too: a dead SD card takes this copy with it.
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# The token is limited to one bucket, so it isn't allowed to check for buckets.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
BACKUP_BUCKET=atelier-backups
BACKUP_PING_URL=https://hc-ping.com/<check-id>
